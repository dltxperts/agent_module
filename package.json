{
  "name": "agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:claude": "DEFAULT_ENGINE=claude bun --watch src/index.ts",
    "dev:codex": "DEFAULT_ENGINE=codex bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "start:session": "scripts/start-agent.sh",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/__tests__/tst_*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-express": "^11.1.24",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.24",
    "@types/bun": "^1.3.12",
    "bun-types": "^1.3.12",
    "typescript": "^6.0.2"
  }
}
