# HTTP port the runtime listens on.
AGENT_PORT=3002

# State directory (sessions / runs / files) and the startup MCP config path.
# AGENT_HOME=~/.agent-runtime
# AGENT_MCP_CONFIG=~/.agent-runtime/mcp-servers.json

# Orders /v1/engines. The engine that actually runs is chosen per-session.
# DEFAULT_ENGINE=claude

# Engine transport modes. Persistent (default) vs per-turn legacy fallback.
# CLAUDE_ENGINE_MODE=stream-json   # or "legacy"
# CODEX_ENGINE_MODE=app-server     # or "legacy"

# Fallback Claude model when a session sets none (otherwise CLI default).
# CLAUDE_MODEL=

# Optional: surface installed skills from <dir>/<id>/SKILL.md in the prompt.
# AGENT_SKILLS_DIR=

# Optional CLI / pool overrides.
# CLAUDE_PROCESS_POOL_SIZE=8
# CLAUDE_PROCESS_IDLE_MS=900000
# CODEX_BIN=codex

# Engines use the Claude / Codex CLIs' own subscription auth — no API keys.
